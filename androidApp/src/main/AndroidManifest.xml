<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ (API 33) requires this to display notifications, including FCM
         "notification" messages sent from the Firebase console: without it, a test
         notification would silently never appear on modern devices. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Not required: heading capture falls back to manual entry when no compass is present. -->
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />

    <application
        android:name=".BelugasApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:enableOnBackInvokedCallback="true">
        <!-- Required for androidx.activity.compose.BackHandler (AppBackHandler.android.kt) to
             actually receive the back-invoked event on API 33+/targetSdk 36, rather than only
             the predictive-back preview/animation phase. Without this, a registered
             BackHandler callback with enabled=true still falls through to the platform default
             (finish the Activity) on real devices. Confirmed live on-device: logcat showed the
             dispatcher setting an isAnimationCallback=true callback, then sendCancelIfRunning,
             then reverting to the default priority=-1 (finish) callback. This flag is what
             routes the real invoke to our callback instead. -->


        <!-- Points FCM at a real, named channel (created in BelugasApplication.onCreate)
             instead of its own auto-created fallback channel, so notifications show up under
             a proper name/description in Android's per-app notification settings. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />

        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".BelugasMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Grants the share-sheet chooser Intent.ACTION_SEND launches temporary read access
             to a data-export file living under cacheDir/exports (see FileSharer.android.kt),
             without exposing the app's files broadly via a file:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.cookinlet.belugas.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>